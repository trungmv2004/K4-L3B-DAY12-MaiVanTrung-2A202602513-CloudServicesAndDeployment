# File này quyết định thứ KHÔNG được copy vào build context / image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Git / CI
.git
.gitignore
.github

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
*.egg-info/

# Không cần khi chạy service
tests/
screenshots/
solution/
nginx/
*.md
grade.py
docker-compose.yml
railway.toml
render.yaml

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
